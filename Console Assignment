using System;

class Program
{
    static void Main(string[] args)
    {
        // ── Part 1: Multiply by 50 ────────────────────────────────
        // Using 'long' instead of 'int' to handle numbers larger than 10,000,000
        // int max is ~2.1 billion but long safely handles much larger values
        Console.WriteLine("Enter a number to multiply by 50:");
        long number1 = Convert.ToInt64(Console.ReadLine());

        // Multiply the input by 50 and print the result
        long result1 = number1 * 50;
        Console.WriteLine(result1);
        Console.WriteLine();

        // ── Part 2: Add 25 ────────────────────────────────────────
        // Using 'double' to allow decimal inputs from the user
        Console.WriteLine("Enter a number to add 25 to:");
        double number2 = Convert.ToDouble(Console.ReadLine());

        // Add 25 to the input and print the result
        double result2 = number2 + 25;
        Console.WriteLine(result2);
        Console.WriteLine();

        // ── Part 3: Divide by 12.5 ───────────────────────────────
        // Using 'double' because dividing by 12.5 can produce decimal results
        Console.WriteLine("Enter a number to divide by 12.5:");
        double number3 = Convert.ToDouble(Console.ReadLine());

        // Divide the input by 12.5 and print the result
        double result3 = number3 / 12.5;
        Console.WriteLine(result3);
        Console.WriteLine();

        // ── Part 4: Greater than 50 check ────────────────────────
        // Using 'double' to allow decimal inputs for comparison
        Console.WriteLine("Enter a number to check if it is greater than 50:");
        double number4 = Convert.ToDouble(Console.ReadLine());

        // Check if the input is greater than 50 — prints True or False
        bool result4 = number4 > 50;
        Console.WriteLine(result4);
        Console.WriteLine();

        // ── Part 5: Remainder after dividing by 7 ────────────────
        // Using 'int' because the modulus (%) operator works with whole numbers
        Console.WriteLine("Enter a number to find the remainder when divided by 7:");
        int number5 = Convert.ToInt32(Console.ReadLine());

        // The % operator returns the remainder of the division
        // e.g. 22 % 7 = 1 because 7 goes into 22 three times (21) with 1 left over
        int result5 = number5 % 7;
        Console.WriteLine(result5);
    }
}