using System;

class Program
{
    static void Main(string[] args)
    {
        // Print the program title to the console
        Console.WriteLine("Anonymous Income Comparison Program");
        Console.WriteLine();

        // ── Person 1 ──────────────────────────────────────────────
        // Print Person 1 header
        Console.WriteLine("Person 1");
        Console.WriteLine();

        // Ask for and read Person 1's hourly rate
        Console.WriteLine("Hourly Rate?");
        double hourlyRate1 = Convert.ToDouble(Console.ReadLine());

        // Ask for and read Person 1's hours worked per week
        Console.WriteLine("Hours worked per week?");
        double hoursPerWeek1 = Convert.ToDouble(Console.ReadLine());

        Console.WriteLine();

        // ── Person 2 ──────────────────────────────────────────────
        // Print Person 2 header
        Console.WriteLine("Person 2");
        Console.WriteLine();

        // Ask for and read Person 2's hourly rate
        Console.WriteLine("Hourly Rate?");
        double hourlyRate2 = Convert.ToDouble(Console.ReadLine());

        // Ask for and read Person 2's hours worked per week
        Console.WriteLine("Hours worked per week?");
        double hoursPerWeek2 = Convert.ToDouble(Console.ReadLine());

        Console.WriteLine();

        // ── Calculate annual salaries ─────────────────────────────
        // Annual salary = hourly rate x hours per week x 52 weeks
        double annualSalary1 = hourlyRate1 * hoursPerWeek1 * 52;
        double annualSalary2 = hourlyRate2 * hoursPerWeek2 * 52;

        // ── Print results ─────────────────────────────────────────
        // Print Person 1's annual salary label and value
        Console.WriteLine("Annual salary of Person 1:");
        Console.WriteLine(annualSalary1);
        Console.WriteLine();

        // Print Person 2's annual salary label and value
        Console.WriteLine("Annual salary of Person 2:");
        Console.WriteLine(annualSalary2);
        Console.WriteLine();

        // Compare salaries and print true or false
        // This evaluates to true if Person 1 earns more, false otherwise
        Console.WriteLine("Person 1 makes more money than Person 2");
        Console.WriteLine(annualSalary1 > annualSalary2);
    }
}